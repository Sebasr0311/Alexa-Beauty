# Production configuration reference. Inject real values through hosting secrets.
# Never commit an actual .env. Spring Boot does not automatically load this file.
SPRING_PROFILES_ACTIVE=prod
DATABASE_URL=jdbc:postgresql://your-host:5432/postgres?sslmode=require
DATABASE_USERNAME=your-database-user
DATABASE_PASSWORD=CHANGE_ME
JWT_SECRET=CHANGE_ME_GENERATE_INDEPENDENT_RANDOM_SECRET_AT_LEAST_32_BYTES
FRONTEND_ORIGIN=https://your-store.example.com
ADMIN_INITIAL_EMAIL=your-admin@example.com
ADMIN_INITIAL_PASSWORD=CHANGE_ME_INDEPENDENT_16_TO_72_CHARACTER_PASSWORD
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=CHANGE_ME
SUPABASE_STORAGE_BUCKET=alexa-beauty-public
WHATSAPP_BUSINESS_NUMBER=CHANGE_ME_REAL_COUNTRY_CODE_AND_NUMBER
RESERVATION_MINUTES=45
DB_POOL_SIZE=5
LOGIN_BUDGET_PER_MINUTE=30
CHECKOUT_BUDGET_PER_MINUTE=120

# Frontend build/runtime (Vercel). Backend URL is server-only; never a public secret.
API_BACKEND_URL=https://your-api.example.com/api/v1
NEXT_PUBLIC_SITE_URL=https://your-store.example.com
NEXT_PUBLIC_WHATSAPP_BUSINESS_NUMBER=CHANGE_ME_SAME_REAL_BUSINESS_NUMBER

# Local development: use SPRING_PROFILES_ACTIVE=dev and frontend npm run dev.
# The dev profile defaults to PostgreSQL localhost:5434; no production secret needed.
